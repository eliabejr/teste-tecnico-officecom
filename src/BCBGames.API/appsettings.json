{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=financial_transactions;Username=postgres;Password=postgres"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topics": {
      "AccountEvents": "account-events",
      "TransactionEvents": "transaction-events"
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "FailOpen": true,
    "KeyPrefix": "ratelimit",
    "DefaultWindowSeconds": 60,
    "DefaultPermitLimit": 300,
    "ExcludedPathPrefixes": [
      "/health",
      "/swagger"
    ],
    "Rules": [
      {
        "PathPrefix": "/api/transactions/purchase",
        "Methods": [ "POST" ],
        "WindowSeconds": 60,
        "PermitLimit": 200
      }
    ]
  }
}
